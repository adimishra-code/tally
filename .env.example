# Server
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb://mongo:27017/tally

# Redis (BullMQ jobs, rate limiting, caching)
REDIS_URL=redis://redis:6379

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Client
CLIENT_ORIGIN=http://localhost:5173
